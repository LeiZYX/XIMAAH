# Copy to .env on the production server:
#   cp .env.production.example .env

# --- MySQL (docker-compose mysql service) ---
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=xima_assessment_hub
MYSQL_USER=xima
MYSQL_PASSWORD=change-me-app-password

# Host must be the docker-compose service name "mysql", not localhost.
DATABASE_URL="mysql://xima:change-me-app-password@mysql:3306/xima_assessment_hub?connection_limit=5&pool_timeout=20"

# --- App auth & URLs ---
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
NEXTAUTH_URL=https://exam.shssip-iedu.cn
APP_URL=https://exam.shssip-iedu.cn
APP_BASE_URL=https://exam.shssip-iedu.cn
NODE_ENV=production

# --- Initial admin (used by prisma db seed) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Admin

# --- Optional ---
BACKUP_CRON_SECRET=replace-with-a-long-random-secret-for-scheduled-backups
BACKUP_DIRECTORY=/var/backups/xima-assessment-hub
# Wall-clock timezone for Backup Settings frequency/time (Weekly Mon, Monthly 1st).
BACKUP_SCHEDULE_TIMEZONE=Asia/Shanghai
# Optional: how often the backup-cron container polls the app (default 900 = 15 min).
# BACKUP_CRON_INTERVAL_SECONDS=900
EXAM_OFFICER_CAN_CONFIGURE_FEE_RULES=false
STUDENT_FEE_STATEMENTS_ENABLED=false

# Set automatically by docker-compose.yml for the app service.
# Use http://localhost:8001 only when running Next.js on the host with a local uvicorn process.
DATA_PROCESSOR_URL=http://data-processor:8001

# --- GlobePay (online fee payment QR codes, GBP / WeChat / Alipay) ---
# GLOBEPAY_PARTNER_CODE=YOUR_PARTNER_CODE
# GLOBEPAY_CREDENTIAL_CODE=YOUR_CREDENTIAL_CODE
# GLOBEPAY_NOTIFY_URL=https://exam.shssip-iedu.cn/api/payments/globepay/notify
# GLOBEPAY_BASE_URL=https://pay.globepay.co

# --- SMTP (password reset emails) ---
# Aliyun Mail (阿里邮箱) SMTP — https://help.aliyun.com/zh/document_detail/36687.html
# Prefer port 465 + SSL on ECS (port 25 is often blocked). Port 80 is also supported without SSL.
# SMTP_HOST=smtp.qiye.aliyun.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@your-domain.com
# SMTP_PASSWORD=mailbox-password-or-client-security-password
# MAIL_FROM=noreply@your-domain.com
# MAIL_FROM="XIMA Assessment Hub <notifications@example.com>"
# PASSWORD_RESET_EXPIRES_MINUTES=60
