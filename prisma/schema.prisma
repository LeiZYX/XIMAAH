/// Ledger for withdrawal credits. Money is refunded offline by finance — never via GlobePay.
model OfflineWithdrawalRefund {
  id                       String                        @id @default(cuid())
  registrationWorkspaceId  String
  registrationWorkspace    RegistrationWorkspace         @relation(fields: [registrationWorkspaceId], references: [id], onDelete: Cascade)
  registrationWindowId     String
  registrationWindow       RegistrationWindow            @relation(fields: [registrationWindowId], references: [id], onDelete: Cascade)
  candidateId              String?
  candidate                Candidate?                    @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  studentId                String?
  registrationId           String?
  examSessionId            String
  examSession              ExamSession                   @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  paperCodeSnapshot        String
  subjectSnapshot          String
  feeStageCode             FeeEntryType
  salesAmountGbp           Decimal                       @db.Decimal(12, 2)
  salesAmountCny           Decimal?                      @db.Decimal(12, 2)
  configuredRefundPercent  Decimal                       @db.Decimal(5, 2)
  paymentFeePercent        Decimal                       @db.Decimal(5, 2)
  effectiveRefundPercent   Decimal                       @db.Decimal(5, 2)
  creditGbp                Decimal                       @db.Decimal(12, 2)
  creditCny                Decimal?                      @db.Decimal(12, 2)
  status                   OfflineWithdrawalRefundStatus @default(PENDING_OFFLINE)
  policyNotes              String?                       @db.Text
  calculationNotes         String?                       @db.Text
  createdByUserId          String
  createdByUser            User                          @relation("OfflineWithdrawalRefundCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  completedAt              DateTime?
  completedByUserId        String?
  completedByUser          User?                         @relation("OfflineWithdrawalRefundCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  offlineReference         String?
  offlineNote              String?                       @db.Text
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt

  @@index([registrationWorkspaceId])
  @@index([registrationWindowId])
  @@index([candidateId])
  @@index([examSessionId])
  @@index([status])
  @@index([createdByUserId])
  @@index([completedByUserId])
  @@index([createdAt])
}

