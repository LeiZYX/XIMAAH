  @@index([registrationWindowId])
  @@index([enabled])
  @@index([sequence])
}

model RegistrationWorkspace {
  id                   String   @id @default(cuid())
  candidateId          String?
  candidate            Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  studentId            String?
