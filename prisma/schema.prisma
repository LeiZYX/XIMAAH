model FeeStatement {
  id                      String                      @id @default(cuid())
  businessType            FeeStatementBusinessType    @default(REGISTRATION)
  candidateId             String?
  candidate               Candidate?                  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  studentId               String?
  student                 User?                       @relation("FeeStatementStudent", fields: [studentId], references: [id], onDelete: Cascade)
  registrationWorkspaceId String?
  registrationWorkspace   RegistrationWorkspace?      @relation(fields: [registrationWorkspaceId], references: [id], onDelete: Cascade)
  registrationWindowId    String?
  registrationWindow      RegistrationWindow?         @relation(fields: [registrationWindowId], references: [id], onDelete: Cascade)
  reviewWindowId          String?
  reviewWindow            ReviewWindow?               @relation(fields: [reviewWindowId], references: [id], onDelete: Cascade)
  statementNo             String                      @unique
  statementKind           FeeStatementKind            @default(NORMAL)
  displayCurrency         FeeStatementDisplayCurrency @default(BOTH)
  exchangeRateSnapshot    Decimal?                    @db.Decimal(12, 4)
  studentNameSnapshot     String
  studentNoSnapshot       String
  gradeSnapshot           String
  classNameSnapshot       String
  emailSnapshot           String?
  assessmentHubCandidateNumberSnapshot String?
  candidateTypeSnapshot                CandidateType?
  status                  FeeStatementStatus          @default(DRAFT)
  studentVisible          Boolean                     @default(true)
  totalGbpAmount          Decimal                     @db.Decimal(12, 2)
  totalCnyAmount          Decimal                     @db.Decimal(12, 2)
  /** Sum of successful online payments already received for this workspace before this statement. */
  previouslyPaidGbpAmount Decimal?                    @db.Decimal(12, 2)
  previouslyPaidCnyAmount Decimal?                    @db.Decimal(12, 2)
  /** Amount still payable on this statement (full or top-up delta). Defaults to total when null (legacy). */
  amountDueGbpAmount      Decimal?                    @db.Decimal(12, 2)
  amountDueCnyAmount      Decimal?                    @db.Decimal(12, 2)
  paymentNotes            String?                     @db.Text
  generatedByUserId       String
  generatedBy             User                        @relation("FeeStatementGenerator", fields: [generatedByUserId], references: [id], onDelete: Cascade)
  generatedAt             DateTime                    @default(now())
  issuedAt                DateTime?
  revisedFromStatementId  String?
  revisedFromStatement    FeeStatement?               @relation("FeeStatementRevisionFrom", fields: [revisedFromStatementId], references: [id], onDelete: SetNull)
  successorStatements     FeeStatement[]              @relation("FeeStatementRevisionFrom")
  revisedToStatementId    String?
  revisedToStatement      FeeStatement?               @relation("FeeStatementRevisionTo", fields: [revisedToStatementId], references: [id], onDelete: SetNull)
  predecessorStatements   FeeStatement[]              @relation("FeeStatementRevisionTo")
  regenerationReason      String?                     @db.Text
  regenerationChangedByUserId String?
  regenerationChangedBy   User?                       @relation("FeeStatementRegenerationChanged", fields: [regenerationChangedByUserId], references: [id], onDelete: SetNull)
  regenerationChangedAt   DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  items FeeStatementItem[]
  paymentOrders        PaymentOrder[]
  reviewRequests       ReviewRequest[]
  cashInRequests       CashInRequest[]
  accessToScriptRequests AccessToScriptRequest[]
  certificateRequests  CertificateRequest[]
  studentNotificationLogs StudentNotificationLog[]

  @@index([candidateId])
  @@index([studentId])
  @@index([registrationWorkspaceId])
  @@index([registrationWindowId])
  @@index([reviewWindowId])
  @@index([businessType])
  @@index([status])
  @@index([statementNo])
  @@index([statementKind])
  @@index([revisedFromStatementId])
  @@index([revisedToStatementId])
  @@index([regenerationChangedByUserId])
}

model PaymentOrder {
  id                String             @id @default(cuid())
  feeStatementId    String
  feeStatement      FeeStatement       @relation(fields: [feeStatementId], references: [id], onDelete: Cascade)
  partnerOrderId    String             @unique
  channel           PaymentChannel
  currency          String             @default("GBP")
  amountMinor       Int
  amountGbp         Decimal            @db.Decimal(12, 2)
  status            PaymentOrderStatus @default(CREATED)
  description       String
  codeUrl           String?            @db.Text
  qrcodeImg         String?            @db.LongText
  payUrl            String?            @db.Text
  globepayOrderId   String?
  paidAt            DateTime?
  notifyPayload     Json?
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledBy       User?              @relation("PaymentOrderCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancelNote        String?            @db.Text
  version           Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([feeStatementId, channel, version])
  @@index([feeStatementId])
  @@index([status])
  @@index([cancelledByUserId])
}

model FeeStatementItem {
