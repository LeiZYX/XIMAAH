  updatedAt DateTime @updatedAt

  registrations  StudentExamRegistration[]
  auditLogs      RegistrationAuditLog[]
  changeRequests RegistrationChangeRequest[]
  feeStatements  FeeStatement[]
  offlineWithdrawalRefunds OfflineWithdrawalRefund[]

  @@unique([candidateId, registrationWindowId, registrationType], map: "rw_candidate_window_type_uq")
  @@unique([studentId, registrationWindowId, registrationType], map: "rw_student_window_type_uq")
  @@index([candidateId])
  @@index([studentId])
  @@index([registrationWindowId])
  @@index([hasPostLockAdjustment])
  @@index([registrationSource])
  @@index([visibility])
  @@index([billingScope])
  @@index([registrationType])
  @@index([entryType])
  @@index([feeStageId])
}

